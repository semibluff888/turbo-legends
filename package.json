{
  "name": "turbo-legends",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Turbo Legends — a Mario Kart-style 3D kart racer that runs in the browser with no build step.",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "test": "node --test",
    "check": "node tools/syntax-check.mjs",
    "smoke:multiplayer": "node tools/multiplayer-load-smoke.mjs",
    "ab:multiplayer-phase2": "node --expose-gc tools/multiplayer-phase2-ab.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "three": "^0.169.0"
  }
}
